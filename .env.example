# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Public URL of this server (Railway domain, or ngrok tunnel for local tool tests).
# Anthropic's servers call the MCP endpoint at {PUBLIC_URL}/mcp/ — it must be
# reachable over the public internet.
PUBLIC_URL=https://your-app.up.railway.app

# Email alerts (Resend — https://resend.com, domain must be verified)
STORE_OWNER_EMAIL=you@yourstore.com
RESEND_API_KEY=re_your-api-key
RESEND_FROM=Cake Canteen Agent <agent@yourdomain.co.za>

# WooCommerce — WooCommerce > Settings > Advanced > REST API
WC_STORE_URL=https://yourstore.com/
WC_CONSUMER_KEY=ck_your-consumer-key
WC_CONSUMER_SECRET=cs_your-consumer-secret

# CORS — comma-separated origins, or * for dev
ALLOWED_ORIGINS=https://yourstore.com

# /mcp auth (ISSUES_LOG.md #2) — run scripts/setup_mcp_vault.py to create the
# vault + get MCP_VAULT_ID. MCP_SHARED_SECRET is comma-separated to allow
# rotation (add the new secret before removing the old one). MCP_AUTH_MODE
# must be "observe" (logs missing/invalid tokens, never rejects — use during
# rollout) or "enforce" (actually rejects) — no default, must be set.
MCP_SHARED_SECRET=
MCP_VAULT_ID=
MCP_AUTH_MODE=observe

# Twilio WhatsApp (optional — set WHATSAPP_ENABLED = True in main.py to activate)
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Filled automatically by server on first run — do not edit.
# On Railway, set these in the service's environment variables (the container
# filesystem is ephemeral, so values written to .env are lost on redeploy).
AGENT_ID=
ENVIRONMENT_ID=
