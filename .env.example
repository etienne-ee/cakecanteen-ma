# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Email alerts (SMTP — use an app password, not your account password)
# Gmail: Google Account → Security → 2-Step Verification → App passwords
STORE_OWNER_EMAIL=you@yourstore.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# WooCommerce — WooCommerce > Settings > Advanced > REST API
WC_STORE_URL=https://yourstore.com/
WC_CONSUMER_KEY=ck_your-consumer-key
WC_CONSUMER_SECRET=cs_your-consumer-secret

# CORS — comma-separated origins, or * for dev
ALLOWED_ORIGINS=https://yourstore.com

# Twilio WhatsApp (optional — set WHATSAPP_ENABLED = True in main.py to activate)
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Filled automatically by server on first run — do not edit
AGENT_ID=
ENVIRONMENT_ID=
